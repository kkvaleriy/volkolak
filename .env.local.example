# Переменные локального клиента. Compose их не читает.
# Подставь адрес сервера и выполни:
#   set -a && source .env.local && set +a && go run ./cmd/api
#
# Swagger: http://localhost:8088/swagger/

TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_WORKFLOW_TASK_QUEUE=volkolak-workflow
TEMPORAL_ACTIVITY_TASK_QUEUE=volkolak-activity
TEMPORAL_SCENE_TASK_QUEUE=volkolak-scene
TEMPORAL_TRANSCRIBE_TASK_QUEUE=volkolak-transcribe

S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minioadmin
S3_BUCKET=volkolak
S3_REGION=us-east-1
S3_USE_SSL=false

HTTP_ADDR=:8088
HTTP_MAX_UPLOAD_MB=2048
WORKFLOW_TIMEOUT_HOURS=48
FRAME_INTERVAL_SEC=2
MAX_FRAMES=30
